{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/book_shot_list",
  "title": "Book Shot List",
  "description": "The director's shot list for one book scene. Every shot is anchored to a verbatim quote of the passage; characters are bound to Kling @ElementN slots from the character_bible.",
  "type": "object",
  "required": [
    "version",
    "book_id",
    "passage",
    "shots",
    "fidelity_review"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "book_id": {
      "type": "string"
    },
    "passage": {
      "type": "object",
      "required": [
        "text",
        "page_start",
        "page_end"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "The exact passage being adapted, verbatim"
        },
        "page_start": {
          "type": "integer"
        },
        "page_end": {
          "type": "integer"
        },
        "setting": {
          "type": "string"
        },
        "time_of_day": {
          "type": "string"
        },
        "mood": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scene_id",
          "source_quote",
          "character_ids",
          "video_prompt",
          "duration_seconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string",
            "description": "Matching scene id in scene_plan"
          },
          "source_quote": {
            "type": "string",
            "description": "Verbatim substring of passage.text that this shot depicts"
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "description": "Order defines the binding: character_ids[0] is @Element1, [1] is @Element2 ..."
          },
          "video_prompt": {
            "type": "string",
            "description": "English prompt. Characters are referenced ONLY as @Element1..@ElementN"
          },
          "camera": {
            "type": "string"
          },
          "dialogue": {
            "type": "string",
            "description": "Verbatim line from the book, or empty"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15
          },
          "continuity_from_previous": {
            "type": "boolean",
            "description": "Use the previous clip's last frame as start_image_url"
          },
          "invented_details": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Visual details NOT stated in the book (filled from visual_style). Must be neutral and never contradict the text."
          },
          "text_overlays": {
            "type": "array",
            "description": "Verbatim book text that must be readable on screen (letters, diary pages, signs). Composited at assembly; the video model must never be asked to write it.",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Verbatim from the book"
                },
                "attribution": {
                  "type": "string",
                  "description": "Who wrote/said it, as in the book"
                },
                "seconds": {
                  "type": "number",
                  "minimum": 1.5
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "fidelity_review": {
      "type": "object",
      "required": [
        "score",
        "approved",
        "issues"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "approved": {
          "type": "boolean"
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
